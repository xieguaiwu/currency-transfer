<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- All traffic is HTTPS; block cleartext and user-added CAs -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
